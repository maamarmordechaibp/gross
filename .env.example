# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Resend (transactional email) — managed via Supabase Edge Function `send-email`.
# Do NOT put the Resend key here. Set it as a Supabase secret instead:
#   supabase secrets set RESEND_API_KEY=re_xxx RESEND_FROM="Gross Printing <noreply@yourdomain.com>"

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
